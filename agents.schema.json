{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liyoclaw1242.github.io/agents.schema.json",
  "title": "Agent roster",
  "description": "本站 agent 團隊的完整名冊。是 city.schema.json（訪客城市格式）的超集：每個 agent 多了契約欄位，每個分區多了規則與流程。",
  "type": "object",
  "required": [
    "version",
    "name",
    "human",
    "zones"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "格式版本；形狀有破壞性變更時才升級"
    },
    "dateModified": {
      "type": "string",
      "format": "date-time",
      "description": "名冊內容最後一次變更的時間"
    },
    "about": {
      "type": "string",
      "description": "這份名冊是什麼、不是什麼（給讀它的 agent）"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "human": {
      "type": "object",
      "description": "城市中心的人類決策者。agent 把需要人決定的事交給他。",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        }
      }
    },
    "delegates": {
      "type": "array",
      "description": "不屬於任何分區、由 human 指派才會出手的支援者",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "assignedBy",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "assignedBy": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "agents"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16
          },
          "subtitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "tagline",
                "outputs",
                "provider",
                "duty",
                "notDo",
                "whenToSpeak",
                "inputs",
                "handoffs",
                "tone"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "maxLength": 40,
                  "description": "全城唯一"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                },
                "tagline": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "description": "一句話定位：它唯一的職責"
                },
                "duty": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160,
                  "description": "職責說明（選填，會顯示在小卡上）"
                },
                "status": {
                  "enum": [
                    "active",
                    "paused"
                  ],
                  "description": "選填。paused：暫停中，樓不亮燈，也不會接到工作"
                },
                "outputs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 5,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 30
                  }
                },
                "handoffs": {
                  "type": "array",
                  "maxItems": 5,
                  "description": "交棒對象：任一 agent 的 id，或 human.id",
                  "items": {
                    "type": "object",
                    "required": [
                      "to"
                    ],
                    "properties": {
                      "to": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                        "maxLength": 40
                      },
                      "when": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 30,
                        "description": "什麼情況交給它（給人看的說明）"
                      },
                      "kind": {
                        "enum": [
                          "forward",
                          "return",
                          "escalate"
                        ],
                        "description": "forward（預設）一般交棒；return 審查退回，城市用紅色貨物表示；escalate 多次退回後交給 human"
                      },
                      "gate": {
                        "enum": [
                          "decision",
                          "report"
                        ],
                        "description": "只在交給 human 時出現：decision 要 human 決定；report 只是告知"
                      }
                    }
                  }
                },
                "provider": {
                  "enum": [
                    "grok",
                    "claude",
                    null
                  ],
                  "description": "由哪個模型執行"
                },
                "notDo": {
                  "type": "string",
                  "minLength": 1,
                  "description": "明確不做的事（權限邊界）"
                },
                "whenToSpeak": {
                  "type": "string",
                  "minLength": 1,
                  "description": "何時主動出聲"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "tone": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "summary": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "goals": {
            "type": "object",
            "description": "這個分區要做好的事，以及各由哪些機器人負責",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "goal",
                    "agents"
                  ],
                  "properties": {
                    "goal": {
                      "type": "string",
                      "minLength": 1
                    },
                    "agents": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "title",
                "text"
              ],
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "workflows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "nodes",
                "edges"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "agent": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "detail": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "enum": [
                          "step",
                          "human",
                          "artifact",
                          "store",
                          "external",
                          "system"
                        ]
                      }
                    }
                  }
                },
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "from",
                      "to"
                    ],
                    "properties": {
                      "from": {
                        "type": "string",
                        "minLength": 1
                      },
                      "to": {
                        "type": "string",
                        "minLength": 1
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "kind": {
                        "enum": [
                          "normal",
                          "reject",
                          "async"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
